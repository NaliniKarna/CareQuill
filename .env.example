# =============================================================================
# MedQueue AI - Environment configuration
# Copy this file to `.env` at the repo root (used by docker-compose.yml) and
# adjust values for your machine. Never commit the real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# development | test | production

# -----------------------------------------------------------------------------
# PostgreSQL (used by docker-compose "db" service AND by the backend)
# -----------------------------------------------------------------------------
POSTGRES_USER=medqueue
POSTGRES_PASSWORD=medqueue_dev_pw
POSTGRES_DB=medqueue_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async DSN the backend actually connects with.
# When running via docker-compose, host is the service name "db".
# When running the backend directly on your machine, use "localhost".
DATABASE_URL=postgresql+asyncpg://medqueue:medqueue_dev_pw@localhost:5432/medqueue_ai
# Separate DB used only by the backend test suite (pytest). Kept isolated
# from the dev database so tests can freely create/drop data.
TEST_DATABASE_URL=postgresql+asyncpg://medqueue:medqueue_dev_pw@localhost:5432/medqueue_ai_test

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Backend server
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# File storage (abstraction: local disk by default, swappable for S3/MinIO)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
# local | s3
STORAGE_LOCAL_PATH=./storage/medical_documents
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# S3 / MinIO (only used when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Email (abstraction: SMTP by default, swappable for SendGrid/Mailgun)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=smtp
# smtp | sendgrid | mailgun | console (console just logs, useful for local dev)
EMAIL_FROM_ADDRESS=no-reply@medqueue.ai
EMAIL_FROM_NAME=MedQueue AI

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# -----------------------------------------------------------------------------
# AI (Ollama by default, local-first; app must run fine with AI_ENABLED=false)
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama
# ollama | none
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
AI_PROMPT_VERSION=v1

# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------
OCR_ENABLED=false
OCR_ENGINE=tesseract
# tesseract | easyocr | paddleocr | none
# tesseract is the only engine implemented so far (pytesseract + Pillow,
# requires the `tesseract-ocr` system package). If that binary isn't
# installed, the app falls back to a no-op engine automatically and logs a
# warning -- it never fails to start because of this.
