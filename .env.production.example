# Domain (use your real values)
DOMAIN=your-real-domain.com
ACME_EMAIL=supportcarequill@gmail.com

# Public URLs: same domain in all three
CORS_ORIGINS=https://your-real-domain.com
FRONTEND_BASE_URL=https://your-real-domain.com
NEXT_PUBLIC_API_BASE_URL=https://your-real-domain.com/api/v1

# Secrets (generate on the server)
POSTGRES_PASSWORD=<openssl rand -hex 24>
JWT_SECRET_KEY=<openssl rand -hex 32>
SMTP_PASSWORD=<16-character Gmail app password>

# Performance
WEB_CONCURRENCY=2

# AI
AI_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
AI_VISION_ENABLED=false
OLLAMA_NUM_CTX=4096

# OCR
OCR_ENABLED=true
OCR_LANGUAGES=eng